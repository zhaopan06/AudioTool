}
QListWidget::item:hover
{
	border:none;
    background: rgba(255,255,255,0.1);
}
QListWidget::item:selected
{
	border:none;
    background: rgba(255,255,255,0.1);
    padding:0px;
    margin:0px;
    border:0px ;
}</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
